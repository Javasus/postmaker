<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="000-setup-auto-increment" author="nosulkora">
        <comment>Настройка автоинкремента для первичных ключей</comment>
    </changeSet>

    <!-- Таблица writers -->
    <changeSet id="001-create-writers-table" author="nosulkora">
        <createTable tableName="writers" schemaName="postmaker">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="writers" indexName="idx_writers_id_status">
            <column name="id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- Таблица labels -->
    <changeSet id="002-create-labels-table" author="nosulkora">
        <createTable tableName="labels" schemaName="postmaker">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="labels" indexName="idx_labels_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="labels" indexName="idx_labels_name">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <!-- Таблица posts -->
    <changeSet id="003-create-posts-table" author="nosulkora">
        <createTable tableName="posts" schemaName="postmaker">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="writer_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_posts_writers" references="writers(id)"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="posts" indexName="idx_posts_writer_id">
            <column name="writer_id"/>
        </createIndex>
        <createIndex tableName="posts" indexName="idx_posts_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- Связующая таблица post_labels -->
    <changeSet id="004-create-post-labels-table" author="nosulkora">
        <createTable tableName="post_labels" schemaName="postmaker">
            <column name="post_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_post_labels_posts" references="posts(id)" deleteCascade="true"/>
            </column>
            <column name="label_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_post_labels_labels" references="labels(id)" deleteCascade="true"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="post_labels" columnNames="post_id, label_id" constraintName="pk_post_labels"/>

        <createIndex tableName="post_labels" indexName="idx_post_labels_post_id">
            <column name="post_id"/>
        </createIndex>
        <createIndex tableName="post_labels" indexName="idx_post_labels_label_id">
            <column name="label_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>